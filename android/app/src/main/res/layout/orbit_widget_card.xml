<?xml version="1.0" encoding="utf-8"?>
<!-- ORBIT 1.5 widget card — flat 1px #e8e8e8, quiet 3%, tabular, honest zero + Qibla compass — MODERN FLAT ICONS -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="12dp">

    <!-- Top: icon 28 + label + bearing badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/card_glyph"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="#111111"
            android:padding="6dp"
            android:src="@drawable/ic_namaz"
            android:contentDescription="icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView
                android:id="@+id/card_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Namaz"
                android:textColor="#111111"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/card_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Next: Dhuhr in 2h 14m"
                android:textColor="#8A8A8A"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Qibla bearing badge — shows 256° W when card is qibla, hidden otherwise -->
        <LinearLayout
            android:id="@+id/card_qibla_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#E6F0EE"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/card_arrow"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_qibla"
                android:contentDescription="bearing" />

            <TextView
                android:id="@+id/card_bearing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="256 W"
                android:textColor="#0E4C46"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/card_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#E6F4EA"
            android:text="14:32"
            android:textColor="#1B7A3D"
            android:textSize="9sp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="8dp" />

    <!-- Title 14/600 tabular -->
    <TextView
        android:id="@+id/card_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fajr 05:18  Dhuhr 12:04"
        android:textColor="#111111"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/card_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Aladhan  Qibla 256 W"
        android:textColor="#8A8A8A"
        android:textSize="10sp"
        android:paddingTop="2dp"
        android:maxLines="1"
        android:ellipsize="end" />

    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <!-- Value pill + compass hint for qibla -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#F5F5F3"
        android:padding="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/card_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Rawalpindi  H 28  L 18"
            android:textColor="#111111"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/card_qibla_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Align"
            android:textColor="#0E4C46"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:visibility="gone"
            android:paddingStart="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=">"
            android:textColor="#8A8A8A"
            android:textSize="12sp"
            android:paddingStart="6dp" />
    </LinearLayout>
</LinearLayout>
